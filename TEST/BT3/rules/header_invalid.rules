# TC04 invalid selectors: one invalid rule must not stop the next.
alert tcp 192.168.1.300 any -> any 80 (msg:"TC04 bad ip"; sid:4100110; rev:1;)
alert tcp any 70000 -> any 80 (msg:"TC04 bad port"; sid:4100111; rev:1;)
alert tcp any 2000:1000 -> any 80 (msg:"TC04 reversed range"; sid:4100112; rev:1;)
alert tcp any any <- any any (msg:"TC04 bad direction"; sid:4100113; rev:1;)
alert tcp any any -> any 443 (msg:"TC04 valid after invalid headers"; sid:4100114; rev:1;)
